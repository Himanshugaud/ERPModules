{
  "name": "erp-modules-backend",
  "version": "1.0.0",
  "description": "Azure Functions backend for ERP modules",
  "main": "dist/src/functions/*.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "clean": "rimraf dist",
    "prestart": "npm run clean && npm run build",
    "start": "func start",
    "test": "npm run build && node --test tests/*.test.cjs"
  },
  "dependencies": {
    "@azure/functions": "^4.0.0",
    "@azure/identity": "4.13.0",
    "mssql": "12.0.0"
  },
  "devDependencies": {
    "@types/mssql": "9.1.7",
    "@types/node": "18.x",
    "rimraf": "^5.0.0",
    "tedious": "19.0.0",
    "typescript": "^4.0.0"
  }
}
